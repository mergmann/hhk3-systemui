{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build for OS 7002",
            "type": "shell",
            "command": "make",
            "args": [ "OS=7002" ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build for OS 2000",
            "type": "shell",
            "command": "make",
            "args": [ "OS=2000" ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": [ ],
            "group": "build"
        },
        {
            "label": "compile commands",
            "type": "shell",
            "command": "make compile_commands.json",
            "problemMatcher": [ ],
            "group": "build"
        }
    ]
}